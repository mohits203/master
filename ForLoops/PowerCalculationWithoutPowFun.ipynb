   "source": [
    "Write a python program to calculate x^y using a loop without using the built-in pow() function."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "3bbef661-9167-45dc-93c3-be0ec0e7e26a",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter X value 2\n",
      "Enter Y value 4\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "32\n"
     ]
    }
   ],
   "source": [
    "x = int(input(\"Enter X value\"))\n",
    "y = int(input(\"Enter Y value\"))\n",
    "value = x\n",
    "for i in range(1,y+1):\n",
    "    value = value * x\n",
    "print(value)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "34048b9b-37e3-4ed2-af40-9cc9042fa852",
   "metadata": {},
   "source": [
    "2*2 = 4\n",
    "4*2 = 8\n",
    "8*2 = 16\n",
    "16*2 = 32"
   ]
  }
 ],
