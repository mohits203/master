   "source": [
    "Write a python program to input a number and find the largest digit in that number using a\n",
    "loop.\n",
    "Example: 58392 → 9"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "a2b23c3b-b78d-475e-b3e6-ad690fbbe47e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Please enter a number 53892\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "9\n"
     ]
    }
   ],
   "source": [
    "n = input(\"Please enter a number\")\n",
    "mod = 0\n",
    "for i in n:\n",
    "    i = int(i)\n",
    "    if(mod < i):\n",
    "        mod = i\n",
    "\n",
    "\n",
    "print(mod)"
   ]
  },
