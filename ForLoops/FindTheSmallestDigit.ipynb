   "source": [
    "Write a python program to input a number and find the smallest digit using a loop.\n",
    "Example: 58392 → 2"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "10c00689-d7d6-48f9-9bc8-047774b8c3eb",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Please enter a number 257831647\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "1\n"
     ]
    }
   ],
   "source": [
    "n = input(\"Please enter a number\")\n",
    "mod = int(n)\n",
    "for i in n:\n",
    "    i = int(i)\n",
    "    if(mod > i):\n",
    "        mod = i\n",
    "\n",
    "\n",
    "print(mod)"
   ]
  },
