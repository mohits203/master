   "source": [
    "Write a PHP program to reverse a string character by character using a loop without using\n",
    "the strrev() function."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "5b650544-2bd6-4a73-a8c7-2cf6778a3986",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Please enter a string :  mohit\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "tihom\n"
     ]
    }
   ],
   "source": [
    "stri = input(\"Please enter a string : \")\n",
    "result = str()\n",
    "for i in stri:\n",
    "        result = i+result\n",
    "print(result)"
   ]
  },
