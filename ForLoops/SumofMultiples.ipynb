   "source": [
    "n = int(input(\"Please enter a number\"))\n",
    "sum = 0\n",
    "for i in range(1,n):\n",
    "    if(i%3 == 0 or i%5 == 0):\n",
    "        sum = i + sum\n",
    "print(f\"Total sum of divisible by 3 and 5 is = {sum}\")"
