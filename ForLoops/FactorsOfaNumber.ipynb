   "source": [
    "Write a python program to display all factors of a number using a loop.\n",
    "Example: 12 → 1, 2, 3, 4, 6, 12"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "ae3c23f4-6323-4337-8608-9040a93ce4d8",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Please enter a number 12\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "1\n",
      "2\n",
      "3\n",
      "4\n",
      "6\n",
      "12\n"
     ]
    }
   ],
   "source": [
    "n = int(input(\"Please enter a number\"))\n",
    "\n",
    "for i in range(1, n+1):\n",
    "    if(n%i == 0):\n",
    "        print(i)\n",
    "        "
   ]
  },
